  "N/A"
 ],
 "hardware_versions": "RevA [A, B, C, D], RevB [D], and RevD [D, E], with {P/Ns ASK3Z-8GB (8GB) [A, B, C, D, E], ASK3Z-16GB (16GB) [A, B, C, D, E], ASK3Z-32GB (32GB) [A, B, C, D, E], ASK3Z-64GB (64GB) [A, B, C, D, E] and ASK3Z-128GB (128GB) [A, B, C, D, E]}",
